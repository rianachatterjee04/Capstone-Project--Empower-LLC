# ============================================================================
# Foundry People (HR) — environment template. Copy to .env and fill in.
# packages/hr-api has its own .env.example with the API-specific settings.
# ============================================================================

# ---- Database ----
# Any Postgres, including a Supabase project. See README.md for the Supabase
# bootstrap path.
DATABASE_URL=postgresql+asyncpg://user@localhost:5432/hr_demo

# ---- Environment ----
# The API treats an UNSET value as production, which disables the dev-auth
# bypass. Local development needs this set explicitly.
ENV=development

# ---- Supabase (real authentication) ----
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_JWT_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Frontends ----
# Both apps read this; the realtime websocket base is derived from it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Employer demo login (client-side gate only, not a security boundary).
NEXT_PUBLIC_DEMO_EMAIL=demo@fintra-hr.test
NEXT_PUBLIC_DEMO_PASSWORD=FintraHrDemo2026!

# Employee portal identifies as this seeded employee.
NEXT_PUBLIC_DEV_EMPLOYEE_EMAIL=liam.eng@northwind.test
