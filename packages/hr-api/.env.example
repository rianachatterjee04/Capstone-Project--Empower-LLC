SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/keys
SUPABASE_JWT_SECRET=

# ---------------------------------------------------------------------------
# DATABASE_URL — point this at Supabase Postgres for cloud, or local Postgres
# for dev. Always use the +asyncpg driver prefix.
#
# Supabase gives you 3 connection strings (Project → Settings → Database):
#
#   Direct (IPv6 only, best for migrations from a v6-capable host):
#     postgresql+asyncpg://postgres:[PWD]@db.<ref>.supabase.co:5432/postgres
#
#   Session pooler (IPv4, persistent connections — good default for the app):
#     postgresql+asyncpg://postgres.<ref>:[PWD]@aws-0-<region>.pooler.supabase.com:5432/postgres
#
#   Transaction pooler (IPv4, serverless/edge; the app sets statement_cache_size=0
#   automatically so asyncpg works through pgBouncer):
#     postgresql+asyncpg://postgres.<ref>:[PWD]@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# session.py auto-detects a Supabase host and applies the pooler-safe asyncpg
# settings — you only need to paste the right URL here.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/postgres
ENV=dev
SERVICE_NAME=foundry-people-backend
# Optional comma-separated browser origins (e.g. http://192.168.1.10:3000 for LAN / Expo web)
CORS_EXTRA_ORIGINS=
INTERNAL_AI_SHARED_SECRET=dev-internal-secret

SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=foundry-people

SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=foundry-people
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# LLM / Embeddings (use mock when OPENAI_API_KEY is unset — required for /ai/memory locally)
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
EMBEDDINGS_PROVIDER=mock
EMBEDDINGS_MODEL=text-embedding-3-small

# Temporal
TEMPORAL_ADDRESS=localhost:7233

# Integrations encryption
INTEGRATIONS_ENC_KEY=

# Expo push
EXPO_PUSH_ACCESS_TOKEN=

# Greenhouse Harvest API (API key based)
GREENHOUSE_API_KEY=
GREENHOUSE_WEBHOOK_SECRET=

# Lever OAuth
LEVER_CLIENT_ID=
LEVER_CLIENT_SECRET=
LEVER_REDIRECT_URI=http://localhost:8000/api/integrations/callback/lever
LEVER_WEBHOOK_SECRET=

# --- Payroll bridge (packages/payroll internal sync seam) ---
# Base URL of the standalone Fintra Payroll service
PAYROLL_API_URL=http://localhost:8050
# Shared secret sent as X-Internal-Secret to /api/payroll/internal/*.
# Must match the payroll service's PAYROLL_INTERNAL_SECRET
# (non-production default on both sides: dev-internal-secret).
PAYROLL_INTERNAL_SECRET=
