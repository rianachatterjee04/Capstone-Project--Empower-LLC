NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
NEXT_PUBLIC_API_BASE_URL=http://localhost:8002/api

# --- Payroll workspace (server-side proxy /api/payroll/[...path]) ---
# Base URL of the standalone Fintra Payroll service (packages/payroll).
PAYROLL_API_URL=http://localhost:8050
# Dev-bearer identity the proxy uses against payroll RBAC when the browser
# doesn't send one (mirrors payroll's dev-token mapping; non-production only).
PAYROLL_DEMO_ORG=11111111-1111-1111-1111-111111111111
PAYROLL_DEV_ROLE=owner
# NOTE: PAYROLL_INTERNAL_SECRET is intentionally NOT configured here — the
# employer proxy uses bearer RBAC only; the internal secret lives in hr-api.
